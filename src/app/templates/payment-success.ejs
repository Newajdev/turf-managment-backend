<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; background-color: #f4f7f6; margin: 0; padding: 0; }
        .wrapper { width: 100%; table-layout: fixed; background-color: #f4f7f6; padding-bottom: 40px; }
        .main { background-color: #ffffff; margin: 0 auto; width: 100%; max-width: 600px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-top: 40px; }
        .header { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); padding: 30px; text-align: center; color: white; }
        .content { padding: 40px; text-align: center; color: #334155; }
        .receipt { background-color: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 25px; margin: 25px 0; text-align: left; }
        .receipt-row { display: flex; justify-content: space-between; margin-bottom: 12px; }
        .receipt-label { font-weight: bold; color: #64748b; }
        .footer { padding: 20px; text-align: center; font-size: 12px; color: #64748b; }
        .amount { font-size: 24px; font-weight: 800; color: #1e293b; margin: 10px 0; }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="main">
            <div class="header">
                <h1>Payment Successful</h1>
            </div>
            <div class="content">
                <h2>Thank You for Your Payment!</h2>
                <p>Hello <%= playerName %>,</p>
                <p>Your payment has been successfully processed. Here is your digital receipt:</p>
                
                <div class="receipt">
                    <div class="receipt-row">
                        <span class="receipt-label">Transaction ID:</span>
                        <span><%= transactionId %></span>
                    </div>
                    <div class="receipt-row">
                        <span class="receipt-label">Date:</span>
                        <span><%= date %></span>
                    </div>
                    <div class="receipt-row">
                        <span class="receipt-label">Booking ID:</span>
                        <span><%= bookingId %></span>
                    </div>
                    <div class="receipt-row" style="margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 15px;">
                        <span class="receipt-label">Amount Paid:</span>
                        <span class="amount"><%= amount %> BDT</span>
                    </div>
                </div>
                
                <p>You can find more details in your dashboard under the "My Bookings" section.</p>
            </div>
            <div class="footer">
                &copy; 2026 Turf Booking System. All rights reserved.
            </div>
        </div>
    </div>
</body>
</html>
