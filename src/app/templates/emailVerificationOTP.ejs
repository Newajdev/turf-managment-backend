<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; }
        .wrapper { width: 100%; table-layout: fixed; background-color: #f4f7f6; padding-bottom: 40px; }
        .main { background-color: #ffffff; margin: 0 auto; width: 100%; max-width: 600px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-top: 40px; }
        .header { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); padding: 30px; text-align: center; color: white; }
        .content { padding: 40px; text-align: center; color: #334155; }
        .otp-code { display: inline-block; padding: 15px 30px; font-size: 32px; font-weight: bold; color: #22c55e; background-color: #f0fdf4; border: 2px dashed #22c55e; border-radius: 8px; margin: 25px 0; letter-spacing: 5px; }
        .footer { padding: 0px; text-align: center; font-size: 12px; color: #64748b; }
        p { line-height: 1.6; }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="main">
            <div class="header">
                <h1>Authentication Required</h1>
            </div>
            <div class="content">
                <h2>Verify Your Identity</h2>
                <p>Hello <strong><%= name %></strong></p>
                <p>To complete your login, please use the following One-Time Password (OTP). This code is valid for  <%= expiresIn %> minutes.</p>
                <div class="otp-code"><%= otp %></div>
                <p>If you did not request this code, please ignore this email and ensure your account security.</p>
            </div>
            <div class="footer">
                &copy; 2026 Turf Booking System. All rights reserved.
            </div>
        </div>
    </div>
</body>
</html>
