<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { padding: 20px; border: 1px solid #ddd; border-radius: 5px; max-width: 600px; margin: 0 auto; }
    .header { background: #f4f4f4; padding: 10px; border-bottom: 1px solid #ddd; text-align: center; font-weight: bold; }
    .content { padding: 20px; }
    .field { margin-bottom: 15px; }
    .label { font-weight: bold; color: #555; }
    .value { margin-top: 5px; padding: 10px; background: #f9f9f9; border-left: 3px solid #007bff; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      New Contact Form Submission
    </div>
    <div class="content">
      <div class="field">
        <div class="label">Name:</div>
        <div class="value"><%= name %></div>
      </div>
      <div class="field">
        <div class="label">Email:</div>
        <div class="value"><%= email %></div>
      </div>
      <div class="field">
        <div class="label">Subject:</div>
        <div class="value"><%= subject %></div>
      </div>
      <div class="field">
        <div class="label">Message:</div>
        <div class="value"><%= message %></div>
      </div>
    </div>
  </div>
</body>
</html>
