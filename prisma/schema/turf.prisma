model Turf {
  id              String         @id @default(uuid(7))
  name            String
  address         String
  contactNumber   String[]
  emailAddress    String?
  isVerifiedEmail Boolean        @default(false)
  description     String?
  images          String[]
  amenities       String[]
  openingTime     String
  closingTime     String
  weeklyOffDays   WeeklyOffDay[]
  isAlwaysOpen    Boolean        @default(false)
  saveCount       Int            @default(0)
  turfStatus      TurfStatus     @default(ACTIVE)
  rating          Decimal    @default(0) @db.Decimal(3, 2)
  reviewCount     Int        @default(0)
  hourlyRate      Decimal    @default(0) @db.Decimal(10, 2)

  ownerId String    @unique
  owner   TurfOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  savedBy Player[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sportTypes      SportType[]
  turfSlots       TurfSlot[]
  bookings        Booking[]
  reviews         Review[]
  customTurfSlots CustomTurfSlot[]
  turfMaintenances TurfMaintenance[]
  reports          Report[]

  @@index([address], map: "idx_turf_address")
  @@map("turf")
}
