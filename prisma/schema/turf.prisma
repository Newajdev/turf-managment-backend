model Turf {
  id          String   @id @default(cuid())
  name        String
  address     String
  description String?
  images      String[]


  ownerId String    @unique
  owner   TurfOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sportTypes SportType[]
  turfSlots TurfSlot[]
  bookings  Booking[]
  reviews   Review[]

  @@index([address], map: "idx_turf_address")
  @@map("turf")
}
