model MasterSlot {
  id        String   @id @default(cuid())
  slotType  SlotType
  startTime String
  endTime   String
  duration  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turfSlots TurfSlot[]

  @@unique([startTime, endTime], name: "uniqe_start_end_time")
  @@map("master_slot")
}
