model Review {
  id      String  @id @default(uuid(7))
  rating  Int
  comment String?

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId], map: "idx_review_playerId")
  @@index([turfId], map: "idx_review_turfId")
  @@map("review")
}
