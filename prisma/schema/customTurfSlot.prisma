model CustomTurfSlot {
  id        String  @id @default(uuid(7))
  startTime String
  endTime   String
  duration  Int
  price     Float
  isBooked  Boolean @default(false)
  status    CustomSlotStatus @default(PENDING)
  needApproval Boolean @default(true)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)
  
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  bookings Booking[]

  @@index([turfId], map: "idx_customSlot_turfId")
  @@map("custom_turf_slot")
}
