model TurfSlot {
  id       String  @id @default(uuid(7))
  price    Decimal    @default(0) @db.Decimal(10, 2)
  isBooking Boolean @default(false)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  slotId String
  slot   MasterSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([turfId], map: "idx_turfslot_turfId")
  @@index([slotId], map: "idx_turfslot_slotId")
  @@map("turf_slot")
}
