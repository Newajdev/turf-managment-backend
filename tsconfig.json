{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "commonjs",
    "target": "ES2022",

    "lib": ["ES2022"],
    "types": ["node"],

    "sourceMap": true,

    "strict": true,

    "esModuleInterop": true,

    "isolatedModules": true,

    "skipLibCheck": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
